# Application
NODE_ENV=development
PORT=3000

# PostgreSQL used by the application and TypeORM migration commands
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vitma_dev
DB_USER=vitma_app
DB_PASS=replace-with-a-local-password

# Separate PostgreSQL database used only by integration tests.
# TEST_DB_HOST/PORT/USER/PASS may be omitted to reuse the DB_* server credentials.
TEST_DB_NAME=vitma_test
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_USER=vitma_app
# TEST_DB_PASS=replace-with-a-local-password
# TEST_DB_ADMIN_NAME=postgres

# Messenger adapters. Use non-production tokens only in local development.
BOT_TOKEN=replace-with-a-telegram-bot-token
BOT_POLLING_ENABLED=true
MAX_BOT_TOKEN=

# Runtime storage paths
PDF_DIR=storage/registrations
CONSENT_DIR=storage/consents

# Server-side sessions. The first superadmin is created explicitly with
# `npm run admin:create`; there are no admin credentials or tokens in config.
ADMIN_SESSION_COOKIE_NAME=vitma_admin_session
ADMIN_SESSION_TTL_HOURS=12
WEB_SESSION_COOKIE_NAME=vitma_web_session
WEB_SESSION_TTL_DAYS=30

# Browser perimeter. Production must list every allowed browser origin.
# Development additionally allows localhost/127.0.0.1 ports 5173 and 5174.
CORS_ORIGINS=
TRUST_PROXY=
# SWAGGER_ENABLED=true
HTTP_JSON_LIMIT=256kb
HTTP_URLENCODED_LIMIT=64kb

# Optional per-bucket rate-limit overrides use:
# RATE_LIMIT_<BUCKET>_LIMIT and RATE_LIMIT_<BUCKET>_WINDOW_SECONDS.
# Example bucket: ADMIN_LOGIN, WEB_SESSION_CREATE, PUBLIC_FORM.
