{
  "name": "learn-bot",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "npm run build:admin && npm run build:site && npm run build:server",
    "build:admin": "vite build --config admin-ui/vite.config.ts",
    "build:site": "tsc -p client-ui/tsconfig.json && vite build --config client-ui/vite.config.ts",
    "build:server": "nest build",
    "build:all": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:system-ca": "set NODE_OPTIONS=--use-system-ca&& nest start",
    "start:dev": "nest start --watch",
    "start:dev:system-ca": "set NODE_OPTIONS=--use-system-ca&& nest start --watch",
    "start:admin": "vite --config admin-ui/vite.config.ts",
    "start:site": "vite --config client-ui/vite.config.ts",
    "start:dev:all": "concurrently -n api,admin,site -c blue,green,magenta \"npm run start:dev:system-ca\" \"npm run start:admin\" \"npm run start:site\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:prod:system-ca": "node --use-system-ca dist/src/main.js",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/db-backup.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/db-restore.ps1",
    "db:test:create": "node scripts/test-database.mjs create",
    "db:test:reset": "node scripts/test-database.mjs reset",
    "db:test:drop": "node scripts/test-database.mjs drop",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "typeorm migration:create src/database/migrations/NewMigration",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/GeneratedMigration -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "schema:log": "npm run typeorm -- schema:log -d src/database/data-source.ts",
    "migration:test:run": "npm run typeorm -- migration:run -d src/database/test-data-source.ts",
    "migration:test:show": "npm run typeorm -- migration:show -d src/database/test-data-source.ts",
    "schema:test:log": "npm run typeorm -- schema:log -d src/database/test-data-source.ts",
    "admin:create": "node -r ts-node/register -r tsconfig-paths/register scripts/admin-create.ts",
    "files:backfill": "node scripts/files-backfill.mjs",
    "backup:create": "node scripts/backup.mjs create --offline-confirm",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "backup:drill": "node scripts/backup.mjs drill --offline-confirm",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:site": "eslint \"client-ui/src/**/*.{ts,tsx}\" \"client-ui/vite.config.ts\"",
    "lint:baseline": "node scripts/lint-baseline.mjs",
    "lint:baseline:update": "node scripts/lint-baseline.mjs --write-baseline",
    "config:check": "node scripts/ci-guard.mjs",
    "database:check": "node scripts/database-check.mjs",
    "ci:quality": "npm run config:check && npm run lint:baseline && npm test -- --runInBand",
    "ci:database": "npm run config:check && npm run database:check && npm run test:integration && npm run test:e2e -- --runInBand",
    "ci:build": "npm run build",
    "ci:offline-smoke": "node scripts/offline-smoke.mjs",
    "test": "jest",
    "test:characterization": "jest --runInBand",
    "test:integration": "npm run db:test:reset && npm run migration:test:run && jest --config ./test/jest-integration.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:site": "node scripts/site-smoke.mjs"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.2.2",
    "@maxhub/max-bot-api": "^0.2.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "gigachat": "^0.0.18",
    "helmet": "^8.3.0",
    "joi": "^18.0.2",
    "lucide-react": "^1.24.0",
    "nestjs-telegraf": "^2.9.1",
    "openai": "^6.15.0",
    "pdfkit": "^0.17.2",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "telegraf-session-local": "^2.1.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
